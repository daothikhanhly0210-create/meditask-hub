// Medical Task Management — data model.
// PostgreSQL is used for both development and production. `role` is stored as
// a String (rather than a Prisma enum) and validated in application code
// (see src/lib/rbac.ts), which keeps the schema portable and easy to evolve.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used by the Prisma CLI for migrations.
  // In production this is the Neon "direct" string; locally it can be omitted.
  directUrl = env("DIRECT_URL")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  nameEn      String?
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  headId String? @unique
  head   User?   @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)

  users User[] @relation("DepartmentMembers")

  workOrderTargets WorkOrderTarget[]

  @@map("departments")
}

model User {
  id                 String  @id @default(cuid())
  email              String  @unique
  name               String
  passwordHash       String
  role               String  @default("STAFF")
  isActive           Boolean @default(true)
  mustChangePassword Boolean @default(true)
  phone              String?
  jobTitle           String?

  departmentId String?
  department   Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)

  headedDepartment Department? @relation("DepartmentHead")

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  auditLogs AuditLog[]

  workOrdersCreated WorkOrder[]           @relation("WorkOrderCreator")
  targetHeads       WorkOrderTarget[]     @relation("WorkOrderTargetHead")
  targetsClosed     WorkOrderTarget[]     @relation("WorkOrderTargetClosedBy")
  subTasksAssigned  SubTask[]             @relation("SubTaskAssignee")
  subTasksCreated   SubTask[]             @relation("SubTaskCreator")
  subTasksApproved  SubTask[]             @relation("SubTaskApprover")
  subTaskWork       SubTaskCollaborator[] @relation("SubTaskCollaborator")
  workOrderFollows  WorkOrderFollower[]   @relation("WorkOrderFollower")
  comments          Comment[]             @relation("CommentAuthor")
  attachments       Attachment[]          @relation("AttachmentUploader")

  @@index([departmentId])
  @@index([role])
  @@map("users")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// B2 — Work assignment (two tiers)
//
//   WorkOrder (phiếu giao việc, board -> many departments)
//     └── WorkOrderTarget (one row per department in the work order)
//           └── SubTask (việc chi tiết, department head -> staff)
//                 └── SubTaskCollaborator (cán bộ phối hợp)
//
// Status values are stored as Strings and validated in application code
// (see src/lib/tasks.ts), keeping the schema portable and easy to evolve.
// Progress percentages are derived from sub-task statuses at read time; they
// are never entered by hand or stored.
// ---------------------------------------------------------------------------

model WorkOrder {
  id          String    @id @default(cuid())
  code        String    @unique // human code, e.g. PGV-2026-001
  title       String
  description String?
  priority    String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  dueDate     DateTime?
  status      String    @default("OPEN") // OPEN | IN_PROGRESS | DONE | CANCELLED
  closedAt    DateTime?

  createdById String
  createdBy   User   @relation("WorkOrderCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targets     WorkOrderTarget[]
  followers   WorkOrderFollower[]
  comments    Comment[]
  attachments Attachment[]

  @@index([createdById])
  @@index([status])
  @@map("work_orders")
}

model WorkOrderTarget {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  // Department head in charge at the time the target was created.
  headId String?
  head   User?   @relation("WorkOrderTargetHead", fields: [headId], references: [id], onDelete: SetNull)

  // A department the board does not need to work on (or has already closed) can
  // be closed with a reason, which counts it as complete for the work order.
  closedAt     DateTime?
  closedReason String?
  closedById   String?
  closedBy     User?     @relation("WorkOrderTargetClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subTasks SubTask[]

  @@unique([workOrderId, departmentId])
  @@index([departmentId])
  @@index([headId])
  @@map("work_order_targets")
}

model SubTask {
  id          String          @id @default(cuid())
  targetId    String
  target      WorkOrderTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  title       String
  description String?
  priority    String          @default("NORMAL")
  dueDate     DateTime?
  status      String          @default("NEW") // NEW | IN_PROGRESS | PENDING_REVIEW | DONE

  mainAssigneeId String?
  mainAssignee   User?   @relation("SubTaskAssignee", fields: [mainAssigneeId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("SubTaskCreator", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("SubTaskApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  rejectReason String?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collaborators SubTaskCollaborator[]
  comments      Comment[]
  attachments   Attachment[]

  @@index([targetId])
  @@index([mainAssigneeId])
  @@index([status])
  @@map("sub_tasks")
}

model SubTaskCollaborator {
  id        String  @id @default(cuid())
  subTaskId String
  subTask   SubTask @relation(fields: [subTaskId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation("SubTaskCollaborator", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subTaskId, userId])
  @@index([userId])
  @@map("sub_task_collaborators")
}

model WorkOrderFollower {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("WorkOrderFollower", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([workOrderId, userId])
  @@index([userId])
  @@map("work_order_followers")
}

model Comment {
  id          String     @id @default(cuid())
  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  subTaskId   String?
  subTask     SubTask?   @relation(fields: [subTaskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("CommentAuthor", fields: [authorId], references: [id])
  body     String

  createdAt DateTime @default(now())

  @@index([workOrderId])
  @@index([subTaskId])
  @@map("comments")
}

model Attachment {
  id          String     @id @default(cuid())
  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  subTaskId   String?
  subTask     SubTask?   @relation(fields: [subTaskId], references: [id], onDelete: Cascade)

  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String
  uploadedBy   User     @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([workOrderId])
  @@index([subTaskId])
  @@map("attachments")
}
