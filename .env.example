# Copy this file to `.env` and fill in real values.

# ---- Database (PostgreSQL) ----
# Neon provides two connection strings: a *pooled* one (host contains
# "-pooler") for the running app, and a *direct* one for migrations.
# For local development you can point both at the same database.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/meditask_hub?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/meditask_hub?sslmode=require"

# ---- Auth (NextAuth / Auth.js v5) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ---- Production administrator (used by `prisma/seed-prod.ts`) ----
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# ---- Email ----
# Leave SMTP_HOST empty to log emails to the console instead of sending them.
# Biên bản (B4a) gửi kèm tệp .docx và .pdf qua các biến này.
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MediTask Hub <no-reply@company.local>"

# ---- Ghi âm (B4b — chưa dùng ở B4a) ----
# Chuyển giọng nói thành văn bản: `groq` dùng Groq Whisper (miễn phí, chỉ cần API key),
# `local` trỏ tới máy chủ Whisper nội bộ của bệnh viện. Cả hai đều dùng API tương thích
# OpenAI, nên chuyển từ Groq sang máy chủ nội bộ chỉ cần đổi biến môi trường, không sửa code.
# Bỏ trống GROQ_API_KEY để tắt phần AI (vẫn ghi biên bản thủ công bình thường).
TRANSCRIPTION_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_WHISPER_MODEL="whisper-large-v3"
LOCAL_TRANSCRIPTION_BASE_URL=""
LOCAL_TRANSCRIPTION_API_KEY=""
LOCAL_TRANSCRIPTION_MODEL="whisper-large-v3"

# Tạo biên bản tự động từ nội dung ghi âm (cũng tương thích OpenAI).
MINUTES_PROVIDER="groq"
MINUTES_MODEL="openai/gpt-oss-120b"
LOCAL_MINUTES_BASE_URL=""
LOCAL_MINUTES_MODEL=""
