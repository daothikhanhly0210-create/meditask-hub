# Copy this file to `.env` and fill in real values.

# ---- Database (PostgreSQL) ----
# Neon provides two connection strings: a *pooled* one (host contains
# "-pooler") for the running app, and a *direct* one for migrations.
# For local development you can point both at the same database.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/hrms?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/hrms?sslmode=require"

# ---- Auth (NextAuth / Auth.js v5) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ---- Production administrator (used by `prisma/seed-prod.ts`) ----
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# ---- Email (optional in Phase 1, used from Phase 4) ----
# Leave SMTP_HOST empty to log emails to the console instead of sending them.
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HRMS Nội bộ <no-reply@company.local>"
